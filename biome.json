{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["src/**"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "rules": {
      "recommended": false,
      "style": {
        "useBlockStatements": "warn",
        "useThrowOnlyError": "warn",
        "useNamingConvention": {
          "level": "warn",
          "options": {
            "conventions": [
              {
                "selector": {
                  "kind": "importNamespace"
                },
                "formats": ["camelCase", "PascalCase"]
              },
              {
                "match": ".*"
              }
            ]
          }
        }
      },
      "suspicious": {
        "noDoubleEquals": "warn"
      }
    }
  },
  "assist": {
    "enabled": false
  }
}
